# Phryvos Development Environment Variables
# Copy this to .env.local and fill in your values

# App
NEXT_PUBLIC_APP_URL=http://localhost:4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phryvos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phryvos

# Redis (for realtime engine, rate limiting, sessions)
REDIS_URL=redis://localhost:6379

# Auth (NextAuth.js)
NEXTAUTH_URL=http://localhost:4000
NEXTAUTH_SECRET=development-secret-key-change-in-production-min-32-chars-long

# OAuth Providers (optional - configure for development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Demo mode (enabled for local development)
NEXT_PUBLIC_DEMO_MODE=true

# Analytics (optional)
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_API_HOST=