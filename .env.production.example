# Phryvos Production Environment Variables
# Copy this to .env.production and fill in your values
# NEVER commit this file with real secrets!

# App
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NODE_ENV=production

# Database (PostgreSQL)
# Use strong passwords, store in secrets manager (AWS Secrets Manager, GCP Secret Manager, etc.)
DATABASE_URL=postgresql://USER:STRONG_PASSWORD@db:5432/phryvos
POSTGRES_USER=phryvos_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=phryvos

# Redis (for realtime engine, rate limiting, sessions)
REDIS_URL=redis://redis:6379

# Auth (NextAuth.js)
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=REPLACE_WITH_32_CHAR_MIN_SECRET

# OAuth Providers (optional - configure in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Tunnel (for production ingress)
CLOUDFLARE_TUNNEL_TOKEN=

# Analytics (optional)
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_API_HOST=

# Demo mode (DISABLE in production)
NEXT_PUBLIC_DEMO_MODE=false